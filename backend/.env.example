# Environment variables — DO NOT COMMIT THIS FILE WITH REAL KEYS
# Copy this to .env and fill in your keys

# === LLM Providers (cascade: Groq → SambaNova → Cerebras) ===
# MULTI-KEY: Use comma-separated keys to pool multiple free accounts.
# Each call rotates to the next key (round-robin). On 429 rate limit,
# the next key is tried immediately.
# Example: GROQ_API_KEY=gsk_key1,gsk_key2,gsk_key3
GROQ_API_KEY=your_groq_key_here
SAMBANOVA_API_KEY=your_sambanova_key_here
CEREBRAS_API_KEY=your_cerebras_key_here

# === Translation (Sarvam AI — 100 free credits) ===
SARVAM_API_KEY=your_sarvam_api_key_here

# === Environmental Data ===
WAQI_API_TOKEN=your_waqi_token_here

# === OKF Bundle Path ===
OKF_BUNDLE_PATH=./icmr-knowledge-bundle

# === Optional: Google Search API for CRAG last resort ===
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
